---
import ContactBlock from '../../components/ContactBlock.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProfile, getProjects } from '../../lib/site';

const profile = await getProfile();
const projects = await getProjects();
---

<BaseLayout title="Projects" description={`Engineering projects by ${profile.name}.`}>
  <PageHeader eyebrow={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`} title="Projects" lede={profile.projectsIntro} />
  <section class="section projects" aria-label="All projects">
    <div class="container">
      <ProjectGrid projects={projects} headingLevel="h2" />
    </div>
  </section>
  <ContactBlock />
</BaseLayout>

<style>
  .projects {
    padding-top: var(--space-5);
  }
</style>
