---
/**
 * Print layout for the downloadable PDF portfolio.
 *
 * This page is NOT part of the published website. `npm run build` renders it
 * to dist/downloads/<Name>-Engineering-Design-Portfolio.pdf and then deletes
 * it from the output (see scripts/build-portfolio-pdf.mjs). While developing
 * you can look at it at http://localhost:4321/portfolio-pdf/.
 *
 * Page 1 is the cover; then one US Letter page per project marked
 * `includeInPdf: true`. Every word comes from the same content files as the
 * website — there is no PDF-specific copy to keep in sync.
 */
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import {
  getPdfCover,
  getPdfProjects,
  getProjectsLeftOutOfPdf,
  PDF_TITLE,
  pdfFileName,
  pdfImage,
  pdfLongSide,
  pdfPath,
} from '../lib/portfolioPdf';
import { pad } from '../lib/site';
import layoutScript from '../pdf/layout.client.js?raw';

const { profile, about, photo, location, blurb } = await getPdfCover();
const projects = await getPdfProjects();
const leftOut = await getProjectsLeftOutOfPdf();

const portrait = await pdfImage(photo, 1100);
const sheets = await Promise.all(
  projects.map(async (project) => ({
    ...project,
    images: await Promise.all(
      project.figures.map((figure) => pdfImage(figure.image, pdfLongSide(project.figures.length, figure.size))),
    ),
  })),
);
const totalPages = sheets.length + 1;

// "UCLA | Mechanical Engineering | Class of 2029" → three parts with dividers.
const schoolParts = profile.eyebrow
  .split('|')
  .map((part) => part.trim())
  .filter(Boolean);

const strip = (address: string) => address.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const siteHref = Astro.site?.href ?? '';
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  ...(profile.linkedin ? [{ label: strip(profile.linkedin), href: profile.linkedin }] : []),
  ...(siteHref ? [{ label: strip(siteHref), href: siteHref }] : []),
];

const fileOf = (image: ImageMetadata) => (image as ImageMetadata & { fsPath?: string }).fsPath?.split('/').pop() ?? '';

/* ------------------------------------------------------------------------ */
/* Manifest — what the finished PDF must (and must not) contain.              */
/* The build script compares the real PDF against this, so a page can never   */
/* silently drift from the source content.                                    */
/* ------------------------------------------------------------------------ */
const labels = {
  role: 'My role',
  organization: 'Organization',
  timeline: 'Timeline',
  glance: 'At a glance',
  skills: 'Engineering skills',
  tools: 'Tools & software',
  contents: 'Projects',
};
const squash = (text: string) => text.normalize('NFKC').replace(/\s+/g, '');
const expect = (field: string, text: string, source: string) => ({ field, text, source });

const coverExpect = [
  expect('Name', profile.name, 'content/profile.yaml → name'),
  ...schoolParts.map((part) => expect('School / major', part, 'content/profile.yaml → eyebrow')),
  expect('Location', location, 'content/profile.yaml → location'),
  expect('About blurb', blurb, 'content/about.md → lede'),
  ...contacts.map((c) => expect('Contact', c.label, 'content/profile.yaml')),
  ...sheets.flatMap((s) => [
    expect('Contents: project title', s.data.title, s.file),
    expect('Contents: role', s.data.role, s.file),
    expect('Contents: organization', s.data.organization, s.file),
  ]),
];

const projectExpect = sheets.map((s) => [
  expect('Project title', s.data.title, `${s.file} → title`),
  expect('Role', s.data.role, `${s.file} → role`),
  expect('Organization', s.data.organization, `${s.file} → organization`),
  expect('Timeline', s.data.timeline, `${s.file} → timeline`),
  expect('At a glance', s.data.summary, `${s.file} → summary`),
  ...s.figures.map((f) => expect('Image caption', f.caption, `${s.file} → gallery → ${fileOf(f.image)}`)),
  ...s.data.skills.map((skill) => expect('Engineering skill', skill, `${s.file} → skills`)),
  ...s.data.tools.map((tool) => expect('Tool / software', tool, `${s.file} → tools`)),
]);

// Text that belongs to the website only and must not leak into the PDF.
const websiteOnly = [
  ...(about.body ?? '')
    .split(/\n\s*\n/)
    .map((paragraph) => ({ text: paragraph.trim(), why: 'About page biography' })),
  ...about.data.highlights.flatMap((h) =>
    [h.summary, ...h.points].map((text) => ({ text: text ?? '', why: 'About page experience (resume content)' })),
  ),
  ...about.data.skills.flatMap((g) => g.items.map((text) => ({ text, why: 'About page skills list' }))),
  { text: profile.tagline, why: 'homepage tagline' },
  { text: profile.intro, why: 'homepage intro' },
  { text: profile.contact.message, why: 'homepage contact message' },
  ...leftOut.flatMap((p) => [
    { text: p.data.title, why: `project left out of the PDF (${p.id})` },
    { text: p.data.summary, why: `project left out of the PDF (${p.id})` },
  ]),
];
const projectOnly = sheets.map((s) => [
  { text: s.data.subtitle, why: 'project subtitle' },
  { text: s.data.status ?? '', why: 'project status' },
  { text: s.data.category, why: 'project category' },
  ...s.data.tags.map((text) => ({ text, why: 'website tag (not listed under skills/tools)' })),
  ...s.data.objectives.map((text) => ({ text, why: 'Objectives section' })),
  ...s.data.outcomes.map((text) => ({ text, why: 'Outcomes section' })),
  ...s.data.contributions.map((text) => ({ text, why: 'What I did section' })),
  ...s.data.decisions.flatMap((d) =>
    [d.title, d.rationale, d.result ?? ''].map((text) => ({ text, why: 'Engineering decisions section' })),
  ),
  ...s.data.metrics.flatMap((m) => [m.label, m.note ?? ''].map((text) => ({ text, why: 'impact metric' }))),
  ...s.data.gallery
    .filter((g) => !g.includeInPdf)
    .map((g) => ({ text: g.caption ?? '', why: `caption of an image left out of the PDF (${fileOf(g.src)})` })),
]);

// A phrase is only "forbidden" on a page if nothing that page is meant to show contains it.
const furniture = [profile.name, PDF_TITLE, ...Object.values(labels)];
const forbidFor = (
  expected: { text: string }[],
  candidates: { text: string; why: string }[],
): { text: string; why: string }[] => {
  const allowed = [...expected.map((e) => e.text), ...furniture].map((t) => squash(t).toLowerCase());
  const seen = new Set<string>();
  return candidates.filter(({ text }) => {
    const key = squash(text).toLowerCase();
    if (key.length < 4 || seen.has(key) || allowed.some((a) => a.includes(key))) return false;
    seen.add(key);
    return true;
  });
};

const manifest = {
  title: `${profile.name} — ${PDF_TITLE}`,
  output: pdfPath(profile),
  fileName: pdfFileName(profile),
  page: { widthIn: 8.5, heightIn: 11 },
  links: contacts.map((c) => c.href),
  pages: [
    {
      kind: 'cover',
      id: 'cover',
      title: 'Cover',
      expect: coverExpect,
      forbid: forbidFor(coverExpect, [...websiteOnly, ...projectOnly.flat()]),
    },
    ...sheets.map((s, i) => ({
      kind: 'project',
      id: s.id,
      title: s.data.title,
      images: s.figures.length,
      expect: projectExpect[i],
      forbid: forbidFor(projectExpect[i], [
        ...websiteOnly,
        ...projectOnly[i],
        // …and nothing from any other project's page.
        ...sheets.filter((other) => other.id !== s.id).map((other) => ({ text: other.data.summary, why: `text from another project (${other.id})` })),
      ]),
    })),
  ],
  leftOut: leftOut.map((p) => ({ id: p.id, title: p.data.title })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{manifest.title}</title>
    <meta name="author" content={profile.name} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <!-- Page 1: cover ------------------------------------------------------ -->
    <section class="sheet cover" data-kind="cover" data-page="1">
      <header class="cover__head">
        <p class="label">{PDF_TITLE}</p>
        <h1 class="cover__name">{profile.name}</h1>
        <p class="cover__school">{schoolParts.map((part) => <span>{part}</span>)}</p>
        <p class="cover__location">{location}</p>
      </header>

      <div class="cover__body">
        <p class="cover__blurb">{blurb}</p>
        <figure class="cover__photo">
          <img
            src={portrait.src}
            width={portrait.width}
            height={portrait.height}
            alt={profile.photoAlt || `Portrait of ${profile.name}`}
          />
        </figure>
      </div>

      <div class="cover__contents">
        <p class="label">{labels.contents}</p>
        <ol>
          {
            sheets.map((s, i) => (
              <li>
                <span class="contents__page">{pad(i + 2)}</span>
                <span class="contents__title">{s.data.title}</span>
                <span class="contents__detail">
                  <span>{s.data.role}</span>
                  <i aria-hidden="true">·</i>
                  <span>{s.data.organization}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="cover__contact">{contacts.map((c) => <a href={c.href}>{c.label}</a>)}</p>
    </section>

    <!-- One page per project ----------------------------------------------- -->
    {
      sheets.map((s, i) => (
        <section class="sheet project" data-kind="project" data-project={s.id} data-page={i + 2}>
          <header class="phead">
            <h2 class="phead__title">{s.data.title}</h2>
            <dl class="meta">
              <div>
                <dt class="label">{labels.role}</dt>
                <dd>{s.data.role}</dd>
              </div>
              <div>
                <dt class="label">{labels.organization}</dt>
                <dd>{s.data.organization}</dd>
              </div>
              <div>
                <dt class="label">{labels.timeline}</dt>
                <dd>{s.data.timeline}</dd>
              </div>
            </dl>
            <div class="glance">
              <p class="label">{labels.glance}</p>
              <p class="glance__text">{s.data.summary}</p>
            </div>
          </header>

          <div class="visuals">
            {s.figures.map((figure, j) => (
              <figure
                data-ratio={(s.images[j].width / s.images[j].height).toFixed(5)}
                data-size={figure.size}
                data-source-width={s.images[j].sourceWidth}
                data-file={fileOf(figure.image)}
              >
                <img src={s.images[j].src} width={s.images[j].width} height={s.images[j].height} alt={figure.alt} />
                <figcaption>{figure.caption}</figcaption>
              </figure>
            ))}
          </div>

          <div class="skills">
            {s.data.skills.length > 0 && (
              <div class="skills__group">
                <p class="label">{labels.skills}</p>
                <ul>
                  {s.data.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            )}
            {s.data.tools.length > 0 && (
              <div class="skills__group">
                <p class="label">{labels.tools}</p>
                <ul>
                  {s.data.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <footer class="foot">
            <span>
              {profile.name} — {PDF_TITLE}
            </span>
            <span>
              {i + 2} / {totalPages}
            </span>
          </footer>
        </section>
      ))
    }

    <script type="application/json" id="pdf-manifest" is:inline set:html={JSON.stringify(manifest).replace(/</g, '\\u003c')} />
    <script is:inline set:html={layoutScript} />
  </body>
</html>

<style is:global>
  /* US Letter, portrait. The sheet's own padding is the page margin, so every
     element stays well inside what an office printer can reach. */
  @page {
    size: 8.5in 11in;
    margin: 0;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* Print-first: white paper, pure black text and rules (gray text prints as a
     dot pattern and loses sharpness). Hierarchy comes from size and weight. */
  body {
    background: #fff;
    color: #000;
    font-family: var(--font-sans), system-ui, sans-serif;
    font-size: 10pt;
    line-height: 1.42;
    hyphens: manual;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ol,
  ul {
    list-style: none;
  }

  .label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 6.8pt;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .sheet {
    --rule: 0.5pt solid #000;
    position: relative;
    width: 8.5in;
    height: 11in;
    padding: 0.55in 0.6in 0.45in;
    overflow: hidden;
    break-after: page;
    break-inside: avoid;
  }

  .sheet:last-of-type {
    break-after: auto;
  }

  /* ---- Cover ------------------------------------------------------------- */
  .cover {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    row-gap: 0.34in;
    padding-top: 0.85in;
    padding-bottom: 0.55in;
  }

  .cover__name {
    margin-top: 0.14in;
    font-size: 44pt;
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cover__school {
    margin-top: 0.22in;
    font-size: 13pt;
    font-weight: 500;
    line-height: 1.3;
  }

  .cover__school span + span::before {
    content: '';
    display: inline-block;
    width: 0.5pt;
    height: 0.15in;
    margin: 0 0.12in;
    background: #000;
    vertical-align: -0.015in;
  }

  .cover__location {
    margin-top: 0.05in;
    font-size: 10.5pt;
  }

  /* Statement on the left, portrait on the right. The portrait takes whatever
     height is left on the page, so a longer project list simply makes it a
     little smaller instead of pushing anything off the page. */
  .cover__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.5in;
    align-items: center;
    min-height: 0;
    padding-top: 0.34in;
    border-top: var(--rule);
  }

  .cover__blurb {
    font-size: 13pt;
    line-height: 1.55;
  }

  .cover__photo {
    height: 100%;
    max-height: 5.2in;
    min-height: 0;
    justify-self: end;
  }

  .cover__photo img {
    display: block;
    width: auto;
    height: 100%;
    max-width: 3.6in;
    object-fit: contain;
    outline: var(--rule);
    outline-offset: -0.5pt;
  }

  .cover__contents ol {
    margin-top: 0.07in;
    border-top: var(--rule);
  }

  .cover__contents li {
    display: grid;
    grid-template-columns: 0.34in minmax(0, 1fr) auto;
    column-gap: 0.1in;
    align-items: baseline;
    padding: 0.065in 0;
    border-bottom: 0.35pt solid #000;
    font-size: 10pt;
  }

  .contents__page {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 7.6pt;
  }

  .contents__title {
    font-weight: 600;
  }

  .contents__detail {
    font-size: 9pt;
    text-align: right;
  }

  .contents__detail i {
    margin: 0 0.05in;
    font-style: normal;
  }

  .cover__contact {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.34in;
    row-gap: 0.04in;
    font-size: 9.5pt;
    font-weight: 500;
  }

  /* ---- Project page: header, visuals, skills, footer ---------------------- */
  .project {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    row-gap: 0.16in;
  }

  .phead {
    display: grid;
    row-gap: 0.12in;
    padding-bottom: 0.15in;
    border-bottom: var(--rule);
  }

  .phead__title {
    font-size: 24pt;
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.018em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.45in;
    row-gap: 0.06in;
  }

  .meta > div {
    display: grid;
    row-gap: 0.02in;
  }

  .meta dd {
    font-size: 10pt;
    font-weight: 500;
    line-height: 1.3;
  }

  .glance {
    display: grid;
    row-gap: 0.03in;
  }

  .glance__text {
    max-width: 7in;
    font-size: 10pt;
    line-height: 1.42;
  }

  /* The image area. scripts in src/pdf/layout.client.js position each figure. */
  .visuals {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
  }

  .vblock {
    position: relative;
    flex: none;
  }

  .vblock figure {
    position: absolute;
  }

  .visuals img {
    display: block;
    outline: var(--rule);
    outline-offset: -0.5pt;
  }

  .visuals figcaption {
    margin-top: 0.05in;
    font-size: 8pt;
    line-height: 1.3;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5in;
    row-gap: 0.05in;
    padding-top: 0.12in;
    border-top: var(--rule);
  }

  .skills__group {
    display: flex;
    align-items: baseline;
    column-gap: 0.12in;
  }

  .skills__group .label {
    flex: none;
  }

  .skills ul {
    display: flex;
    flex-wrap: wrap;
    font-size: 9.2pt;
    font-weight: 500;
    line-height: 1.35;
  }

  .skills li + li::before {
    content: '·';
    margin: 0 0.07in;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    font-size: 6.8pt;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  /* ---- On-screen preview only (npm run dev → /portfolio-pdf/) --------------- */
  @media screen {
    body {
      padding: 24px 0;
      background: #6b6f76;
    }

    .sheet {
      margin: 0 auto 24px;
      background: #fff;
      box-shadow: 0 2px 14px rgb(0 0 0 / 35%);
    }
  }
</style>
