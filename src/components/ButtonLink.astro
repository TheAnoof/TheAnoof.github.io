---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  download?: string | boolean;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  icon,
  iconPosition = 'end',
  download,
  external = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  download={download}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={17} />}
  <span><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={17} class="btn__end" />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn--primary:hover {
    background: var(--accent-strong);
    color: var(--on-accent);
  }

  .btn--secondary {
    background: var(--surface);
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .btn--secondary:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .btn--quiet {
    padding-inline: 0.25rem;
    min-height: 2.25rem;
    color: var(--accent);
  }

  .btn--quiet:hover {
    color: var(--accent-strong);
  }

  .btn :global(.btn__end) {
    transition: transform var(--dur) var(--ease);
  }

  .btn:hover :global(.btn__end) {
    transform: translateX(2px);
  }
</style>
