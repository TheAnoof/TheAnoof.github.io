---
/** Engineering decisions: what was decided, why, and what happened. */
import { pad } from '../lib/site';

interface Props {
  decisions: { title: string; rationale: string; result?: string }[];
}

const { decisions } = Astro.props;
---

<ol class="decisions" role="list">
  {
    decisions.map((d, i) => (
      <li class="decision">
        <p class="label decision__num">Decision {pad(i + 1)}</p>
        <h4 class="decision__title">{d.title}</h4>
        <dl class="decision__body">
          <div>
            <dt class="label">Rationale</dt>
            <dd>{d.rationale}</dd>
          </div>
          {d.result && (
            <div>
              <dt class="label">Result</dt>
              <dd>{d.result}</dd>
            </div>
          )}
        </dl>
      </li>
    ))
  }
</ol>

<style>
  .decisions {
    display: grid;
    gap: var(--space-4);
  }

  .decision {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .decision__num {
    color: var(--accent);
  }

  .decision__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .decision__body {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (min-width: 45rem) {
    .decision__body:has(> div + div) {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-5);
    }
  }

  .decision__body dd {
    margin-top: var(--space-1);
    color: var(--ink-2);
  }
</style>
