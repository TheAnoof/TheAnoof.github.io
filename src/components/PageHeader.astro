---
/** Top-of-page header used on About, Projects, and Resume. */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Put the lede in a white panel (used on About, where the lede is long). */
  boxedLede?: boolean;
}

const { eyebrow, title, lede, boxedLede = false } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <p class="label page-header__eyebrow rise" style="--i: 0">{eyebrow}</p>
    <!-- Text and optional aside (e.g. the About photo) share one row, so the
         aside spans exactly from the top of the title to the bottom of the text. -->
    <div class="page-header__inner">
      <div class="page-header__text">
        <h1 class="page-header__title rise" style="--i: 1">{title}</h1>
        {
          lede && (
            <p class:list={['page-header__lede', 'rise', { 'panel page-header__lede--boxed': boxedLede }]} style="--i: 2">
              {lede}
            </p>
          )
        }
        <slot />
      </div>
      <slot name="aside" />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 1.6rem + 4vw, 5rem) var(--space-5);
  }

  .page-header__eyebrow {
    margin-bottom: var(--space-4);
  }

  .page-header__inner {
    display: grid;
    gap: var(--space-6);
  }

  /* With an aside: two columns; the aside stretches to the text's height. */
  @media (min-width: 52rem) {
    .page-header__inner:has(> :nth-child(2)) {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-8);
    }
  }

  .page-header__text {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }

  .page-header__title {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .page-header__lede {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .page-header__lede--boxed {
    max-width: 44rem;
    color: var(--ink);
  }
</style>
