---
import { getProfile, url } from '../lib/site';

const profile = await getProfile();
const year = new Date().getFullYear();
const revision = new Date().toISOString().slice(0, 10);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__id">
      <p class="site-footer__name">{profile.name}</p>
      <p class="site-footer__headline">{profile.headline}</p>
    </div>
    <ul class="site-footer__links" role="list">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      {profile.linkedin && <li><a href={profile.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>}
      {profile.github && <li><a href={profile.github} rel="noopener noreferrer" target="_blank">GitHub</a></li>}
      <li><a href={url('/resume/')}>Resume</a></li>
    </ul>
    <p class="label site-footer__meta">
      <span>© {year} {profile.name}</span>
      <span>Rev. {revision}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--rule);
    background: var(--paper-sunk);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-6);
  }

  @media (min-width: 45rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__meta {
      grid-column: 1 / -1;
    }
  }

  .site-footer__name {
    font-weight: 600;
  }

  .site-footer__headline {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
    font-weight: 500;
  }

  /* Comfortable tap targets (≥ 24 px tall). */
  .site-footer__links a {
    display: inline-block;
    padding-block: 0.3rem;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
</style>
