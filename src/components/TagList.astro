---
interface Props {
  items: string[];
  label?: string;
  size?: 'sm' | 'md';
}

const { items, label, size = 'md' } = Astro.props;
---

{
  items.length > 0 && (
    <ul class:list={['tags', `tags--${size}`]} role="list" aria-label={label}>
      {items.map((item) => (
        <li class="tag">{item}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .tags--sm .tag {
    padding: 0.1rem 0.5rem;
    font-size: 0.8125rem;
  }
</style>
