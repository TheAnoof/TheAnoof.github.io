---
/**
 * Figure gallery for CAD, drawings, test photos and diagrams. Each figure is
 * numbered (Fig. 01, 02...) and links to the full-resolution image.
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { pad } from '../lib/site';

interface Props {
  items: { src: ImageMetadata; alt: string; caption?: string }[];
}

const { items } = Astro.props;

// Full-size versions (max 2400 px wide) for the "open image" links.
const fullSize = await Promise.all(
  items.map((item) => getImage({ src: item.src, width: Math.min(item.src.width, 2400) })),
);
---

<ol class="gallery" role="list">
  {
    items.map((item, i) => (
      <li>
        <figure class="figure">
          <a href={fullSize[i].src} class="figure__link" aria-label={`Open full-size image: ${item.alt}`}>
            <Image
              src={item.src}
              alt={item.alt}
              widths={[480, 800, 1200, 1600].filter((w) => w <= item.src.width)}
              sizes="(min-width: 72rem) 36rem, (min-width: 45rem) 50vw, 100vw"
              class="figure__img"
            />
          </a>
          <figcaption>
            <span class="label figure__num">Fig. {pad(i + 1)}</span>
            {item.caption && <span>{item.caption}</span>}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ol>

<style>
  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6) var(--space-5);
  }

  @media (min-width: 45rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .figure {
    display: grid;
    gap: var(--space-3);
  }

  .figure__link {
    display: block;
    overflow: hidden;
    border: var(--image-border-width) solid var(--image-border-color);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: zoom-in;
  }

  .figure__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--surface);
  }

  figcaption {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  .figure__num {
    flex-shrink: 0;
    color: var(--accent);
  }
</style>
